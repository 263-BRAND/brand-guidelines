{
  "version": "2.0",
  "colorSchemes": {
    "group-red": {
      "primary": "#D0121B",
      "primaryLight": "#FE343F",
      "primaryDark": "#AC000A",
      "accent": "#FF777F",
      "dark": "#2D3847",
      "gray": "#595959",
      "lightGray": "#F2F2F2",
      "white": "#FFFFFF",
      "black": "#000000"
    },
    "business-blue": {
      "primary": "#1677FF",
      "primaryLight": "#4A9BFF",
      "primaryDark": "#0055CC",
      "accent": "#E6F0FF",
      "dark": "#2D3847",
      "gray": "#595959",
      "lightGray": "#F2F2F2",
      "white": "#FFFFFF",
      "black": "#000000"
    }
  },
  "typography": {
    "fontFamily": "\"微软雅黑\", \"Microsoft YaHei\", sans-serif",
    "unit": "pt",
    "html": {
      "minSize": 20,
      "scale": {
        "coverTitle":   { "template": 64, "themed": { "min": 56, "max": 72 } },
        "contentTitle": { "template": 40, "themed": { "min": 36, "max": 44 } },
        "subtitle":     { "template": 30, "themed": { "min": 28, "max": 32 } },
        "body":         { "template": 26, "themed": { "min": 24, "max": 28 } },
        "caption":      { "template": 22, "themed": { "min": 20, "max": 24 } }
      }
    },
    "pptx": {
      "minSize": 12,
      "scale": {
        "coverTitle":   { "template": 64, "themed": { "min": 56, "max": 72 } },
        "contentTitle": { "template": 24, "themed": { "min": 22, "max": 26 } },
        "subtitle":     { "template": 20, "themed": { "min": 18, "max": 22 } },
        "body":         { "template": 18, "themed": { "min": 16, "max": 20 } },
        "caption":      { "template": 14, "themed": { "min": 12, "max": 16 } }
      }
    }
  },
  "logos": {
    "group": {
      "color": "assets/logos/logo-group-color.png",
      "white": "assets/logos/logo-group-white.png"
    },
    "cloud": {
      "color": "assets/logos/logo-cloud-color.png",
      "white": "assets/logos/logo-cloud-white.png"
    },
    "businessLines": {
      "group": { "color": "assets/logos/logo-group-color.png", "white": "assets/logos/logo-group-white.png" },
      "cloud-communication": { "color": "assets/logos/logo-cloud-color.png", "white": "assets/logos/logo-cloud-white.png" }
    }
  },
  "slogan": "assets/slogan.png",
  "hardRules": {
    "logo": {
      "innerPageSize": "4.2% of canvas width, square (aspect-ratio:1)",
      "safeZone": "Logo矩形边界框内禁止任何内容像素进入——包括文字、页码、装饰、图标、分割线、背景图形。无一例外",
      "shallowBg": "彩稿Logo",
      "darkBg": "反白Logo",
      "endingPage": "居中Logo + slogan PNG"
    },
    "typography": {
      "absoluteMinSize": "20pt",
      "bodyMinSize": "24pt",
      "fontFamily": "微软雅黑"
    },
    "color": {
      "primary": "#D0121B",
      "disallowed": "严禁使用非色板颜色"
    }
  },
  "layout": {
    "coverLogo": {
      "left": "6%",
      "top": "8%",
      "size": "6.5%"
    },
    "innerPageLogo": {
      "right": "4.2%",
      "top": "4.3%",
      "size": "4.2%"
    }
  },
  "backgrounds": {
    "cover": {
      "primary-gradient": "linear-gradient(135deg, {primary} 0%, {primaryDark} 100%)",
      "primary-solid": "{primary}",
      "dark-solid": "{dark}",
      "white": "{white}"
    },
    "inner": {
      "white": "{white}",
      "light-gray": "{lightGray}"
    }
  }
}

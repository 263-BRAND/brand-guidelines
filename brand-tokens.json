{
  "version": "2.1",
  "colorSchemes": {
    "group-red": {
      "primary": "#D0121B",
      "primaryLight": "#FE343F",
      "primaryDark": "#AC000A",
      "accent": "#FF777F",
      "dark": "#2D3847",
      "gray": "#595959",
      "lightGray": "#F2F2F2",
      "white": "#FFFFFF",
      "black": "#000000"
    },
    "business-blue": {
      "primary": "#1677FF",
      "primaryLight": "#4A9BFF",
      "primaryDark": "#0055CC",
      "accent": "#E6F0FF",
      "dark": "#2D3847",
      "gray": "#595959",
      "lightGray": "#F2F2F2",
      "white": "#FFFFFF",
      "black": "#000000"
    }
  },
  "typography": {
    "fontFamily": "\"微软雅黑\", \"Microsoft YaHei\", sans-serif",
    "minSize": "20pt",
    "minBodySize": "24pt",
    "sizes": {
      "coverTitle": { "template": "64pt", "themed": { "min": "56pt", "max": "72pt" } },
      "sectionTitle": { "template": "40pt", "themed": { "min": "36pt", "max": "44pt" } },
      "pageTitle": { "template": "40pt", "themed": { "min": "36pt", "max": "44pt" } },
      "subtitle": { "template": "30pt", "themed": { "min": "24pt", "max": "32pt" } },
      "body": { "template": "26pt", "themed": { "min": "24pt", "max": "28pt" } },
      "caption": { "template": "22pt", "themed": { "min": "20pt", "max": "24pt" } }
    },
    "asciiArt": {
      "fontFamily": "'Courier New','Source Code Pro',Consolas,monospace",
      "fontSize": "11pt",
      "lineHeight": "0.6",
      "scaleX": "1.8",
      "overallScaleX": "0.576",
      "overallScaleY": "0.528",
      "offsetX": "0",
      "exemption": "ASCII 字符画属于装饰图形，不受 minSize 16px 限制"
    }
  },
  "logos": {
    "group": {
      "color": "assets/logos/logo-group-color.png",
      "white": "assets/logos/logo-group-white.png"
    },
    "cloud": {
      "color": "assets/logos/logo-cloud-color.png"
    }
  },
  "slogan": "assets/slogan.png",
  "layout": {
    "safeArea": {
      "top": "8%",
      "bottom": "8%",
      "left": "5%",
      "right": "5%"
    },
    "coverLogo": {
      "left": "6%",
      "top": "8%",
      "size": "6.5%"
    },
    "innerPageLogo": {
      "right": "5.2%",
      "top": "5.3%",
      "width": "80px",
      "height": "80px"
    }
  },
  "backgrounds": {
    "cover": {
      "white": "{white}",
      "primary-gradient": "linear-gradient(135deg, {primary} 0%, {primaryDark} 100%)",
      "primary-solid": "{primary}",
      "dark-solid": "{dark}"
    },
    "inner": {
      "white": "{white}"
    }
  },
  "hardRules": {
    "logo": {
      "innerPageSize": "80x80px (4.2% of 1920px canvas width), square",
      "safeZone": "Logo矩形边界框内禁止任何内容像素进入",
      "shallowBg": "彩稿Logo",
      "darkBg": "反白Logo",
      "endingPage": "居中Logo + slogan PNG"
    },
    "typography": {
      "html": { "absoluteMinSize": "20pt", "bodyMinSize": "24pt" },
      "pptx": { "absoluteMinSize": "12pt", "bodyMinSize": "16pt" },
      "fontFamily": "微软雅黑"
    },
    "color": {
      "primary": "#D0121B",
      "disallowed": "严禁使用非色板颜色"
    }
  },
  "coverAscii": {
    "art": "                                         ▓▓▓▓▓▒\n                                  ▓▓██████████████▓\n                              ██████████████████████▓\n                          ▓███████████████████████████\n                       ▒██████████████████████████████▒\n                     ▓█████████████████████████████████\n                   ████████████████████████████████████\n                 ██████████████████████████████████████\n                ███████████████████████████████████████\n               ▒███████████████████████████████████████\n               ████████████████████████████████████████\n               ████████████████████████████████████████\n               ███████████████████████████████████████▓\n               ▓███▓▓▓▓▓▓▓▓▓▓█▓▓▓██▓▓▓▓▓▓█▓▓▓▓▓▓▓▓▓▓██\n               ▒███          █   █      ██          ██\n               ▒██████████   █   █▓▓▓▓▓▓█████████   █\n                ██          ▓▓          █▓         ▒█\n                ██          █           █▒         ▓▒\n                ▒█  ▒████████   █████   ████████   ▓\n                 ▒         ▓█          ▒▓         ▒\n                 ▓         ██         ▓█▓▒▒      ▓▒\n                 ▓███████████████████████████████▓\n                  ███████████████████████████████\n                  ██████████████████████████████\n                   ████████████████████████████▒\n                   ███████████████████████████▓\n                    █████████████████████████▓\n                    ████████████████████████▓\n                     ██████████████████████▓\n                     ▓████████████████████▓\n                      ███████████████████\n                       █████████████████\n                        ██████████████▓\n                         ████████████\n                          █████████▒\n                           ▒████▒\n",
    "color": "{primary}",
    "stagger": 30,
    "transition": "0.6s ease",
    "slideDistance": "60px",
    "rule": "ASCII 字符画从 brand-tokens.json 读取，禁止 AI 自行生成或修改。每行独立 <span> + 奇偶交错滑入，JS setTimeout 逐行动画。"
  }
}
